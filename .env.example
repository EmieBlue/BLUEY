# Copy this file to ".env" (same folder) and fill in your two Supabase values.
# Find them in: Supabase Dashboard -> Project Settings -> API
#   - "Project URL"            -> EXPO_PUBLIC_SUPABASE_URL
#   - "Project API keys" anon  -> EXPO_PUBLIC_SUPABASE_ANON_KEY
#
# The anon key is safe to ship in a client app (that's what it's designed for).
# After editing .env, fully restart the dev server (stop it and run `npm run web`
# again) so Expo picks up the new values.
#
# IMPORTANT: never put a database password or any secret in THIS file — .env.example
# is committed to git. Secrets belong in .env (app) or .env.seed (scripts); both are
# gitignored.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
