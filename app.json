{
  "expo": {
    "name": "Bluey",
    "slug": "Bluy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bluey-logo.png",
    "scheme": "bluy",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#023025",
        "foregroundImage": "./assets/images/bluey-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/bluey-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#023025",
          "image": "./assets/images/bluey-logo.png",
          "imageWidth": 200,
          "android": {
            "image": "./assets/images/bluey-logo.png",
            "imageWidth": 200
          }
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
